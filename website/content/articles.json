      "status": "published",
      "title": "Exploring Takashi Murakami's Iconic Art Style: The Superflat Revolution",
      "dek": "",
      "category": "Art & Photography",
      "categories": [
        "Art & Photography"
      ],
      "tags": [
        "Art & Photography"
      ],
      "format": "",
      "author": "Loughercontemporary.com",
      "authorUrl": "http://loughercontemporary.com",
      "date": "August 26th, 2026",
      "updatedDate": "",
      "eyebrow": {
        "category": "Art"
      },
      "thumbnailImage": {
