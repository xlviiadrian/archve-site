    "the-night-shift-portraits-of-the-people-who-keep-the-city-breath": {
      "id": "the-night-shift-portraits-of-the-people-who-keep-the-city-breath",
      "slug": "what-the-f-ck-is-archve",
      "status": "published",
      "title": "What the f*ck is ARCHVE?",
      "dek": "ARCHVE is aiming to document Art, Records, Culture, Humanity, Visions & Expression from people all over the world. We believe theres already so much media based around big people, and big stories going on in the world, but, there's so much more out there that just simply isn't being documented.",
      "category": "Latest",
      "categories": [
