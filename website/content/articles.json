    "who-is-facetime-frostie": {
      "id": "who-is-facetime-frostie",
      "slug": "who-is-facetime-frostie",
      "status": "published",
      "title": "Who is Facetime Frostie?",
      "dek": "With “#TEETH” out now and “#LOSING” approaching, the Houston artist is entering a new era built around more than music.",
      "category": "Music",
      "categories": [
        "Music"
      ],
      "tags": [
        "Facetime Frostie",
        "Savoir Frostie",
