      "seo": {
        "title": "Your London Fashion Week SS27 cheat sheet is here!",
        "description": "From McQueen’s dramatic return to a new slate of up-and-coming talent, here’s everything you need to know about SS27 season this September",
        "primaryKeyword": "",
        "canonical": "",
        "ogTitle": "",
        "ogDescription": "",
